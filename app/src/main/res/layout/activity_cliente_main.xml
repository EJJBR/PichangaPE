<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- Mensaje de bienvenida idéntico al de dueños -->
    <TextView
        android:id="@+id/tvBienvenidaCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="¡Te damos la bienvenida, Cliente!"
        android:textColor="#616161"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenedor de botones de navegación superior -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBotonesCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#f0f0f0"
        app:layout_constraintTop_toBottomOf="@id/tvBienvenidaCliente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- Botón Canchas -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerCanchas"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="Canchas"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF5252"
                app:cornerRadius="16dp" />

            <!-- Botón Mis Reservas -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMisReservas"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="Mis Reservas"
                android:textColor="#424242"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Filtro de búsqueda -->
    <SearchView
        android:id="@+id/svFiltroCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:queryHint="Buscar cancha..."
        app:layout_constraintTop_toBottomOf="@id/cardBotonesCliente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:background="@drawable/card_background"/>

    <!-- RecyclerView para el listado -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvClientePrincipal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/svFiltroCliente"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
