<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/design_default_color_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvTituloRegistro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registro de Cliente"
                android:textColor="#101010"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/txtRegNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/black"
                android:hint="Nombre"
                android:inputType="textPersonName"
                android:textColor="#101010"
                app:layout_constraintTop_toBottomOf="@+id/tvTituloRegistro" />

            <EditText
                android:id="@+id/txtRegApellido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/black"
                android:hint="Apellido"
                android:inputType="textPersonName"
                android:textColor="#101010"
                app:layout_constraintTop_toBottomOf="@+id/txtRegNombre" />

            <EditText
                android:id="@+id/txtRegCelular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/black"
                android:hint="Número de Celular"
                android:inputType="phone"
                android:textColor="#101010"
                app:layout_constraintTop_toBottomOf="@+id/txtRegApellido" />

            <EditText
                android:id="@+id/txtRegCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/black"
                android:hint="Correo Electrónico"
                android:inputType="textEmailAddress"
                android:textColor="#101010"
                app:layout_constraintTop_toBottomOf="@+id/txtRegCelular" />

            <TextView
                android:id="@+id/tvTipoDocLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tipo de Documento:"
                android:textColor="#101010"
                app:layout_constraintTop_toBottomOf="@+id/txtRegCorreo"
                app:layout_constraintStart_toStartOf="parent" />

            <Spinner
                android:id="@+id/spinnerTipoDoc"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/tvTipoDocLabel" />

            <EditText
                android:id="@+id/txtRegDocumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/black"
                android:hint="Número de Documento"
                android:inputType="text"
                android:textColor="#101010"
                app:layout_constraintTop_toBottomOf="@+id/spinnerTipoDoc" />

            <TextView
                android:id="@+id/tvFechaNacLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Fecha de Nacimiento:"
                android:textColor="#101010"
                app:layout_constraintTop_toBottomOf="@+id/txtRegDocumento"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/lyRegFechaNac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tvFechaNacLabel">
                <Spinner android:id="@+id/spinnerRegDia" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" />
                <Spinner android:id="@+id/spinnerRegMes" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" />
                <Spinner android:id="@+id/spinnerRegAnio" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1.2" />
            </LinearLayout>

            <EditText
                android:id="@+id/txtRegUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/black"
                android:hint="Usuario"
                android:inputType="text"
                android:textColor="#101010"
                app:layout_constraintTop_toBottomOf="@+id/lyRegFechaNac" />

            <EditText
                android:id="@+id/txtRegPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/black"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:textColor="#101010"
                app:layout_constraintTop_toBottomOf="@+id/txtRegUsuario" />

            <Button
                android:id="@+id/btnFinalizarRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:backgroundTint="@drawable/btn_color_selector"
                android:text="Registrarse"
                android:textColor="#FDFDFD"
                app:cornerRadius="4dp"
                app:layout_constraintTop_toBottomOf="@+id/txtRegPassword" />

            <Button
                android:id="@+id/btnCancelarRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@drawable/btn_color_selector"
                android:text="Cancelar"
                android:textColor="#FDFDFD"
                app:cornerRadius="4dp"
                app:layout_constraintTop_toBottomOf="@+id/btnFinalizarRegistro" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
